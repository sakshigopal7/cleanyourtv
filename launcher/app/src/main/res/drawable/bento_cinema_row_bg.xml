<?xml version="1.0" encoding="utf-8"?>
<!-- Focus background for a cinema title row: the same clear visible focus box as the
     posters (3dp amber ring) plus a faint amber fill, so the focused title reads at a
     glance. Transparent when unfocused; no system highlight anywhere. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#14FFC107" />
            <stroke android:width="3dp" android:color="#FFC107" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
