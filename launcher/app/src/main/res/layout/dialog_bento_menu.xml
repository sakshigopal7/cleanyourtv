<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bento_card_bg"
    android:padding="24dp">
    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@string/font_medium"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/menuSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_regular"
            android:maxLines="1"
            android:ellipsize="end" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="#20FFFFFF" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/menuItem1" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/pill_bg" android:textColor="@drawable/pill_text" android:textSize="14sp" android:fontFamily="@string/font_medium" android:focusable="true" android:clickable="true" />
            <TextView android:id="@+id/menuItem2" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/pill_bg" android:textColor="@drawable/pill_text" android:textSize="14sp" android:fontFamily="@string/font_medium" android:focusable="true" android:clickable="true" />
            <TextView android:id="@+id/menuItem3" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginBottom="6dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/pill_bg" android:textColor="@drawable/pill_text" android:textSize="14sp" android:fontFamily="@string/font_medium" android:focusable="true" android:clickable="true" />
            <TextView android:id="@+id/menuItem4" android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/pill_bg" android:textColor="@drawable/pill_text" android:textSize="14sp" android:fontFamily="@string/font_medium" android:focusable="true" android:clickable="true" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
