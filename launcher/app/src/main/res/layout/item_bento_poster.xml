<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="115dp"
    android:layout_height="172dp"
    android:layout_marginEnd="14dp"
    android:focusable="true"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bento_poster_card_bg"
    android:foreground="@drawable/bento_poster_focus_ring">

    <ImageView
        android:id="@+id/posterImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bento_poster_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/posterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:fontFamily="@string/font_medium"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/posterGenre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="0.03"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/posterBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="@drawable/bento_badge_bg"
        android:textColor="#E6FFFFFF"
        android:textSize="10sp"
        android:fontFamily="@string/font_medium"
        android:letterSpacing="0.04"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/posterPlatformIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="4dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/posterPlatform"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/bento_badge_bg"
            android:textColor="#E6FFFFFF"
            android:textSize="10sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.04"
            android:visibility="gone" />

        <TextView
            android:id="@+id/posterNew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/bento_new_bg"
            android:textColor="#212121"
            android:textSize="10sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.04"
            android:text="New"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
